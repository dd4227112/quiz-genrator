APP_NAME="Interview Question Generator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL connection (required). Tests use a separate database named
# interview_generator_test on the same server (see phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=interview_generator
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the generation job timeout (900s) so long jobs are not re-run mid-flight.
DB_QUEUE_RETRY_AFTER=960

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- AI provider -------------------------------------------------------------
# Which QuestionGenerator implementation to bind (currently: openai).
AI_PROVIDER=openai

# OpenAI credentials. Never commit real keys.
OPENAI_API_KEY=
# Optional: only sent as the OpenAI-Organization header when set.
OPENAI_ORGANIZATION=
OPENAI_BASE_URL=https://api.openai.com/v1
# Required: a current OpenAI chat model ID. Read from env, never hardcoded.
OPENAI_MODEL=
OPENAI_MAX_COMPLETION_TOKENS=8000
# Optional: leave empty to omit temperature (some models don't support it).
OPENAI_TEMPERATURE=

# Seconds to wait for a single AI HTTP request.
AI_REQUEST_TIMEOUT=120
# Upper bound for the "number of questions" field.
AI_MAX_QUESTIONS_PER_REQUEST=30
